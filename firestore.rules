rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for UserProfile
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('lastActiveAt' in data) || (data.lastActiveAt is timestamp && data.lastActiveAt <= request.time));
    }

    // Validation helper for ChatSessionDoc
    function isValidChatSession(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.lastMessagePreview is string && data.lastMessagePreview.size() <= 500 &&
             data.messageCount is int && data.messageCount >= 0 &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // Validation helper for ChatMessageDoc
    function isValidChatMessage(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.sender in ['USER', 'MONTANA', 'SYSTEM'] &&
             data.content is string && data.content.size() <= 10000 &&
             (!('toolCalls' in data) || (data.toolCalls is list && data.toolCalls.size() <= 20));
    }

    // Validation helper for AiToolDoc
    function isValidAiTool(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 200)) &&
             data.purpose is string && data.purpose.size() > 0 && data.purpose.size() <= 1000 &&
             data.category is string && data.category.size() <= 50 &&
             data.isEnabled is bool &&
             data.executionCount is int && data.executionCount >= 0 &&
             (!('capabilities' in data) || (data.capabilities is list && data.capabilities.size() <= 20));
    }

    // Validation helper for OptimizationRecordDoc
    function isValidOptimizationRecord(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.module is string && data.module.size() <= 100 &&
             data.metricBefore is string && data.metricBefore.size() <= 200 &&
             data.metricAfter is string && data.metricAfter.size() <= 200 &&
             data.percentageGain is string && data.percentageGain.size() <= 50 &&
             data.diffSnippet is string && data.diffSnippet.size() <= 5000 &&
             data.explanation is string && data.explanation.size() <= 2000 &&
             data.status is string && data.status.size() <= 50;
    }

    // Users collection
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());
      allow update: if isOwner(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming());
      allow delete: if isOwner(userId);

      // Sessions subcollection
      match /sessions/{sessionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         isValidChatSession(incoming());
        allow update: if isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidChatSession(incoming());
        allow delete: if isOwner(userId);

        // Messages subcollection
        match /messages/{messageId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) &&
                           incoming().userId == request.auth.uid &&
                           incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                           isValidChatMessage(incoming());
          allow update: if isOwner(userId) &&
                           incoming().userId == existing().userId &&
                           incoming().createdAt == existing().createdAt &&
                           isValidChatMessage(incoming());
          allow delete: if isOwner(userId);
        }
      }

      // Tools subcollection
      match /tools/{toolId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         isValidAiTool(incoming());
        allow update: if isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidAiTool(incoming());
        allow delete: if isOwner(userId);
      }

      // Optimizations subcollection
      match /optimizations/{optimizationId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         isValidOptimizationRecord(incoming());
        allow update: if isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidOptimizationRecord(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
